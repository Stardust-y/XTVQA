class BiBERT(BaseEstimator, TransformerMixin):
    def __init__(self, max_len=64, device='cuda'):
        self.max_len = max_len
        self.device = device

    def fit(self, X, y):
        return self

    def transform(self, X):
        return [self._transform(x) for x in X]
```

