        add_special_tokens=True,
        max_length=512,
        return_tensors='pt'
    )
    outputs = model(**inputs)
    start_scores, end_scores = outputs.start_logits, outputs.end_logits
    all_start_scores, all_end_scores = [], []
    for i in range(len(context)):
        all_start_scores.append(start_scores[i])
        all_end_scores.append(end_scores[i])

    best_score_id = np.argmax(all_start_scores + all_end_scores)
    best_score = all_start_scores[best_score_id] + all_end_scores[best_score_id]
    answer_start_index = np.argmax(all_start_scores[:best_score_id]) + 1
    answer_end_index = np.argmax(all_end_scores[:best_score_id]) + 1
    answer = context[answer_start_index:answer_end_index]

    return answer

context = "我喜欢吃苹果。"
question = "你喜欢吃什么水果？"

print(get_answer(question, context))
```

注意：这个代码需要使用transformers库，如果你还没有安装，可以使用pip install transformers命令进行安装。此外，由于BERT模型的预训练参数是在英文语料上训练的，对于中文语料可能效果不佳，因此在实际应用中可能需要对模型进行微调或者选择其他的模型。
